# Copy to .env and fill in real values locally. Never commit .env.
# Every environment variable the code reads must be listed here with a placeholder.
#
# Nothing in the code reads these yet; they are reserved for the planned pipeline.
# Remove any that end up unused.

# LLM provider used for assessment / labeling (model choice: see the master design document)
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# Local paths for the ML pipeline (both git-ignored)
DATA_DIR=./data
MODEL_DIR=./ml/models

# Frontend: Vite only exposes variables prefixed with VITE_ to the browser.
# Never put a secret in a VITE_ variable: it ends up in the public GitHub Pages bundle.
VITE_API_BASE_URL=http://localhost:8000
